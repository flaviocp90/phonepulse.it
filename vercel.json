{
  "functions": {
    "api/article.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/chi-siamo",
      "destination": "/api/retired-admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/retired-admin"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/articoli/:slug",
      "destination": "/api/article?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/categoria/news",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sitemap",
      "destination": "/",
      "permanent": true
    }
  ]
}
